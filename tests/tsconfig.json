{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "types": ["jest"],
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": true
  },
  // The base config excludes "tests"; re-include it here so the compile-time
  // type tests (@ts-expect-error / Expect<...>) are enforced by `tsc` too.
  "exclude": ["node_modules", "dist"],
  "include": [".", "../src"]
}
